{
  "log": { "level": "error" },
  "dns": {
    "servers": [
      {
        "tag": "proxy-dns",
        "address": "https://1.1.1.1/dns-query",
        "detour": "proxy",
        "strategy": "ipv4_only"
      }
    ],
    "rules": [{ "outbound": "any", "server": "proxy-dns" }],
    "final": "proxy-dns"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "${SERVER_IP}",
      "server_port": ${VLESS_PORT},
      "uuid": "${VLESS_UUID}",
      "tls": {
        "enabled": true,
        "server_name": "ads.x5.ru",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "${REALITY_PUBLIC_KEY}",
          "short_id": "${REALITY_SHORT_ID}"
        }
      }
    },
    {
      "type": "hysteria2",
      "tag": "hysteria2",
      "server": "${SERVER_IP}",
      "server_port": ${HYSTERIA_PORT},
      "password": "${HYSTERIA_PASSWORD}",
      "tls": {
        "enabled": true,
        "server_name": "bing.com",
        "insecure": true
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rule_set": [
      {
        "tag": "geoip-bypass",
        "type": "remote",
        "format": "source",
        "url": "https://storage.yandexcloud.net/sing-box/rule-set/geoip/${COUNTRY_CODE}.json",
        "download_detour": "direct"
      }
    ],
    "rules": [
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "ip_is_private": true, "outbound": "direct" },
      { "rule_set": "geoip-bypass", "outbound": "direct" },
      { "network": "udp", "outbound": "hysteria2" },
      { "network": "tcp", "outbound": "proxy" }
    ],
    "final": "proxy",
    "auto_detect_interface": true
  }
}
