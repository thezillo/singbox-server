{
  "$schema": "https://raw.githubusercontent.com/nicktomlin/tauri-settings-schema/master/v2.json",
  "productName": "Singbox",
  "version": "0.1.0",
  "identifier": "com.singbox.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Singbox",
        "width": 400,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
